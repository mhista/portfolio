# Public URL of the site (used for SEO, sitemap and Open Graph images)
NEXT_PUBLIC_SITE_URL=https://diweinnocent.vercel.app

# Contact form: where messages are delivered
CONTACT_TO=diweesomchi@gmail.com

# Option A: Resend (recommended on Vercel). Needs a verified sender domain, or use onboarding@resend.dev for testing.
RESEND_API_KEY=
CONTACT_FROM="Diwe Innocent <hello@kymaa.tech>"

# Option B: SMTP (e.g. Gmail with an app password). Used when RESEND_API_KEY is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# With neither configured, the form still works: it opens the visitor's email app instead.
